# Copy this file to .env.local for local development.
# Keep .env.local private. Do not commit or paste real keys into docs/logs.

# OpenAI-compatible LLM provider. Leave empty to use the built-in demo fallback.
OPENAI_API_KEY=replace_with_your_openai_or_compatible_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternative provider variable names also supported by lib/ai/provider.ts.
LLM_API_KEY=
LLM_MODEL=

# Azure Speech. Leave empty to use Web Speech / text fallback.
AZURE_SPEECH_KEY=replace_with_your_azure_speech_key
AZURE_SPEECH_REGION=eastasia

# Dev-only operations controls. These are ignored in production builds.
# FACEWALL_DEMO_MODE: auto | fallback
FACEWALL_DEMO_MODE=auto
# FACEWALL_DEV_FAULTS: comma-separated llm,tts
FACEWALL_DEV_FAULTS=

# Internal beta data/auth foundation. Server-only; never prefix with NEXT_PUBLIC_.
# Use a least-privilege runtime account for DATABASE_URL and a separate migration/admin
# account for DATABASE_ADMIN_URL. Add `?options=-c%20search_path%3Dauth,public` to the
# Better Auth connection when the provider does not configure the search path.
DATABASE_URL=postgresql://passbuddy_app:replace_password@127.0.0.1:5432/passbuddy
DATABASE_ADMIN_URL=postgresql://passbuddy_admin:replace_password@127.0.0.1:5432/passbuddy
# `docker compose up -d postgres` local-only defaults:
# DATABASE_URL=postgresql://passbuddy_app:passbuddy_app_local@127.0.0.1:5432/passbuddy
# DATABASE_ADMIN_URL=postgresql://passbuddy_admin:passbuddy_admin_local@127.0.0.1:5432/passbuddy
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
INTERNAL_BETA_AUTH_ENABLED=true
INTERNAL_BETA_PERSISTENCE_MODE=source
# Keep enabled for internal-beta; disable only for explicit local compatibility tests.
INTERNAL_BETA_REQUIRE_CONSENT=true
# Controlled pilot value. Change to 300-600 before production launch and rerun OTP E2E.
AUTH_OTP_EXPIRES_IN_SEC=1800

# IB-02 email delivery. Values stay blank until the SES domain/template are approved.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_TEMPLATE_ID=
# Optional local-only recipient for `npm run ses:probe -- --send`.
TENCENT_SES_TEST_EMAIL=

# OTP budget controls. Tune these to the active SES quota before each pilot batch.
AUTH_OTP_EMAIL_DAILY_LIMIT=5
AUTH_OTP_IP_DAILY_LIMIT=20
AUTH_OTP_GLOBAL_WARN_LIMIT=400
AUTH_OTP_GLOBAL_STOP_LIMIT=450
